APP_ENV=development
APP_NAME=Mini E-Commerce Tracking
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/mini_ecommerce
TEST_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/mini_ecommerce_test
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_ORIGIN=http://localhost:5173
# Product image objects: local directory and public URL prefix.
OBJECT_STORAGE_DIR=./uploads
OBJECT_STORAGE_URL_PREFIX=/uploads
# Optional absolute origin when the API runs behind a proxy/CDN.
OBJECT_STORAGE_PUBLIC_BASE_URL=
MAX_UPLOAD_BYTES=5242880
SHIPPING_FEE=0.00
CURRENCY_CODE=USD
REPORT_TIMEZONE=UTC
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-me-now